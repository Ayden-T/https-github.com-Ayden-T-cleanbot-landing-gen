DATABASE_URL="file:./dev.db"

# Meta Developer App credentials (see README.md for how to get these)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Must exactly match the redirect URI configured under Instagram business
# login in the Meta app. Instagram's login product requires https:// even
# for local dev - `npm run dev` runs Next.js over HTTPS (self-signed) for
# exactly this reason.
INSTAGRAM_REDIRECT_URI="https://localhost:3000/api/auth/instagram/callback"
