DATABASE_URL="file:./dev.db"

# Meta Developer App credentials (see README.md for how to get these)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Must exactly match a "Valid OAuth Redirect URI" configured on the Meta app,
# and must be reachable from the browser doing the OAuth redirect.
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"
